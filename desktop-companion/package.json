{
  "name": "macau-pos-desktop-companion",
  "version": "0.1.3",
  "description": "Macau POS Desktop：Electron 殼載 Vercel 網頁 + 內嵌打印 Companion 代理（localhost:9311），經 OS 權限打 LAN/USB/BT。可打包成 exe 安裝檔並內建檢查更新。",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "serve": "node server.mjs",
    "dist": "electron-builder --win nsis",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "bonjour": "^0.1.2",
    "iconv-lite": "^0.6.3",
    "electron-updater": "^6.3.4",
    "serialport": "^12.0.0",
    "usb": "^2.12.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0"
  },
  "engines": {
    "node": ">=18"
  },
  "build": {
    "appId": "com.macau.pos.desktop",
    "productName": "Macau POS Desktop",
    "directories": {
      "output": "dist",
      "buildResources": "electron"
    },
    "files": [
      "companion-server.mjs",
      "server.mjs",
      "electron/**/*",
      "companion.config.json"
    ],
    "publish": {
      "provider": "generic",
      "url": "https://macau-pos-system.vercel.app/releases/",
      "channel": "latest"
    },
    "win": {
      "target": "nsis",
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Macau POS Desktop"
    }
  }
}
