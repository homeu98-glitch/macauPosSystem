# ===== print-bridge 環境變數 =====
# 複製成 .env 後填寫（start.sh / dotenv 會自動載入）

# 基本（HTTP，預設）
PRINT_BRIDGE_HOST=0.0.0.0
PRINT_BRIDGE_PORT=9222

# ===== Path ②：雲端 HTTPS POS 連 LAN bridge 必須開 HTTPS =====
# 設 "1" 啟用 HTTPS（POS 改為用 https://bridge.yourdomain.com 連）
PRINT_BRIDGE_TLS=1

# Let's Encrypt 證書路徑（由 scripts/issue-cert.sh 經 DNS-01 發出）
# 無 domain 就用自簽：bash scripts/issue-selfsigned.sh 生成，再指落下面兩行
PRINT_BRIDGE_TLS_CERT=/etc/print-bridge/bridge.yourdomain.com.fullchain.cer
PRINT_BRIDGE_TLS_KEY=/etc/print-bridge/bridge.yourdomain.com.key
# 自簽方案請改成（路徑按你 CERT_OUT_DIR，見 docs/33 方案 B）：
# PRINT_BRIDGE_TLS_CERT=$HOME/print-bridge-certs/bridge-selfsigned.cer
# PRINT_BRIDGE_TLS_KEY=$HOME/print-bridge-certs/bridge-selfsigned.key

# HTTPS 監聽 port（443 需要 root；一般用 8443）
PRINT_BRIDGE_TLS_PORT=8443

# 可選：同時開 HTTP 9222（只做店內本地除錯，POS 請用 HTTPS）
PRINT_BRIDGE_ALSO_HTTP=0
