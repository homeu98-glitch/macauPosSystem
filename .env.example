# =============================================================================
# Macau POS — Environment Variables
# Copy to `.env.local` (local) or set in Vercel Project Settings (deploy).
# Do NOT commit `.env.local`.
# =============================================================================

# -----------------------------------------------------------------------------
# A. Ledger Supabase（必填 — 登入 + 線上訂單 + Realtime）
#    與 Macau-Ledger 共用同一個 Supabase 專案
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-ledger-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-ledger-anon-key

# Server-only — 與 Ledger Vercel 部署相同的 pepper；勿加 NEXT_PUBLIC_ 前綴
AUTH_PIN_PEPPER=

# -----------------------------------------------------------------------------
# A-1b. Ledger Supabase **service_role** key（可選；2026-09-21 新增）
#   ⚠️ 只為一件事：驗證 `merchants` 表有冇某個 storeId。
#      背景：`/api/pos/print-agent/pair` 嘅 storeId 驗真以前用 **POS 專案**嘅 client
#      查 `merchants` —— 但 `merchants` 係 **Ledger** 專案嘅表 ⇒ 一定 404（PGRST205）
#      ⇒ fail-open 放行 ⇒ 驗真**從未生效**（實測 log 見到 404）。
#      後果：用唔存在嘅 storeId 都配得到對 ⇒「顯示已連線但一張都印唔出」。
#
#   🔴 權限取捨（**開之前要清楚接受**）：
#      呢支 key ＝ **POS 部署可以完整讀寫整個 Ledger 資料庫**（service_role bypass RLS）。
#      POS 目前只有 Ledger anon 權限 ⇒ 呢一步係**權限升級**：POS 一洩漏 service key，
#      影響面由 `pos_*` 擴大到「整個 Ledger」。
#
#   ✅ **更保守嘅替代（長遠推薦）**：請 Ledger 側開一支
#      `GET /api/integration/pos/merchant-exists?storeId=`
#      （走既有 `LEDGER_INTEGRATION_BASE_URL` ＋ `LEDGER_WEBHOOK_SECRET` 簽名，
#       同 `ensure-customer` 同一模式）⇒ POS 完全唔需要特權 Ledger 憑證。
#
#   ⚠️ **唔設都唔會壞**：未設 → 驗真維持 fail-open（行為同修復前一樣），
#      只係唔會再白打一個註定 404 嘅查詢。所以要開就開，唔開亦可以照上線。
#   取法：Ledger Supabase Dashboard → Project Settings → API → service_role secret
# LEDGER_SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# A-2. Ledger 本體 base URL（確保會員建檔 ensure-customer 薄轉發用）
#     POS 伺服器路由 /api/ledger/ensure-customer 會帶店員 Bearer token 轉發到
#     `{LEDGER_INTEGRATION_BASE_URL}/api/integration/pos/ensure-customer`。
#     ⚠️ 入面預設值係 UAT（https://membership-uat.macau-tech.com）。
#        正式環境**必須**設去 production：
#        LEDGER_INTEGRATION_BASE_URL=https://membership.macau-tech.com
#     - 正式部署：喺 Vercel Project Settings → Environment Variables 設
#       （Production scope），唔使寫入任何檔案。
#     - 本地對 production 測試：寫入 `.env.local`（gitignore，唔會 commit）。
#     - 此變數只喺 server 端 Route Handler 讀，唔使加 NEXT_PUBLIC_ 前綴。
# -----------------------------------------------------------------------------
# LEDGER_INTEGRATION_BASE_URL=https://membership.macau-tech.com

# -----------------------------------------------------------------------------
# A-3. Ledger → POS 入站 webhook 簽名 secret（線上訂單「自動接單」雙向同步用，docs/92）
#      POS 伺服器路由 /api/integration/ledger/auto-accept 會用呢支 secret 驗 HMAC-SHA256 簽名：
#        signing_string = X-Pos-Timestamp + "." + raw_body
#        X-Pos-Signature: sha256=<hex>
#      ⚠️ **必須**同 Ledger 嗰邊夾定同一支值；server-only，**絕不加 NEXT_PUBLIC_ 前綴**。
#      未設定 → 入站 webhook 一律 500（唔會放行無簽名請求）。
# -----------------------------------------------------------------------------
# LEDGER_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# A-4. Ledger → POS **出站查詢**簽名 secret（線下營業摘要，2026-09-25 新增）
#
#      方向同 A-3 **相反**：今次係 **Ledger 伺服器打過嚟** POS 一支唯讀 GET：
#        GET /api/integration/ledger/offline-report?storeId&from&to
#        X-Ledger-Timestamp: <unix 秒>
#        X-Ledger-Signature: HMAC-SHA256(secret, ts + "." + "GET" + "." + pathWithQuery).hex
#      驗簽：`src/lib/pos/offline-report.ts`；路線：`.../api/integration/ledger/offline-report/route.ts`。
#
#      🔴 **必須同 LEDGER_WEBHOOK_SECRET 分開**（唔同方向、唔同用途；共用一把 ⇒
#         任何一邊被 compromise 就兩邊一齊爆）。亦**唔可以** fallback 落 webhook secret。
#      🔴 **絕對唔可以加 NEXT_PUBLIC_ 前綴**（加咗等於公開，任何人都叫得到全店報表聚合）。
#      ⚠️ 未設定 ⇒ 呢條 route 一律 **500 fail-closed**（唔會放行無簽名請求）；
#         設／改完要**重新部署** Vercel 才生效。
#      取法：由 Ledger 側產生（≥32 hex）私訊交換，唔進 git、唔進 issue。
#      契約：docs/integration/pos-offline-report-api.md
# -----------------------------------------------------------------------------
# LEDGER_OFFLINE_REPORT_HMAC_SECRET=

# -----------------------------------------------------------------------------
# D. 會員線上充值審核（topUpAutomation iframe SSO）
#    TOPUP_SITEA_SSO_SECRET 須與 Ledger / topUpAutomation 的 SITEA_SSO_SECRET 相同
# -----------------------------------------------------------------------------
# TOPUP_SITEA_SSO_SECRET=
# TOPUP_SITEA_SSO_ISSUER=site-a
# TOPUP_SITEA_SSO_AUDIENCE=site-b
# NEXT_PUBLIC_TOPUP_BASE_URL=https://top-up-automation.vercel.app
# 店員登入號 ≠ 充值店舖編號時，以 merchant UUID 對應 8 位編號（例：表嫂美食 60000000）
# TOPUP_SHOP_ID_OVERRIDES={"11111111-1111-1111-1111-111111111111":"60000000"}

# -----------------------------------------------------------------------------
# C. 打印橋接（Android POS App 或 print-bridge）
#    瀏覽器 POS 透過此 URL 送打印任務；亦可在 設置→打印機 填寫本機橋接 URL 覆蓋
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_PRINT_BRIDGE_URL=http://192.168.1.50:9222

# -----------------------------------------------------------------------------
# B. POS 自有 Supabase（可選 — 店內雲同步 / Admin / Backoffice）
#    與 Ledger 分開的獨立專案；只用 SUPABASE_*，不要加 NEXT_PUBLIC_
#    若不配置：店內收銀仍可用 localStorage；Admin 用 mock
# -----------------------------------------------------------------------------
# SUPABASE_URL=https://your-pos-project.supabase.co
# SUPABASE_ANON_KEY=your-pos-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-pos-service-role-key

# -----------------------------------------------------------------------------
# B-2. 🔴 前端 Realtime 專用（2026-09-10 新增 — 修「新單唔自動彈出」）
#
#     背景：server 寫 pos_orders 用 `SUPABASE_URL`（POS 專案），但**瀏覽器 Realtime**
#     一向讀 `NEXT_PUBLIC_SUPABASE_URL`（= A 段 Ledger 專案，冇任何 pos_* 表）
#     → 收銀台訂咗一張唔存在嘅表 → 永遠收唔到推送，但 Supabase **唔會報錯**
#     → 只有 F5 reload（行 /api/pos/state backfill）先見到新單。
#
#     修法：把**同一個 POS 專案**的 URL + anon key 再加一份 NEXT_PUBLIC_ 公開變數。
#     - 有設 → Realtime 訂正確專案（即時通知恢復）。
#     - 未設 → 向後兼容退回舊變數（行為不變，但即時通知依然失效）。
#
#     ⚠️ 安全前提（必須在 POS 專案確認，見 supabase/migrations/0016 §3 + 0021）：
#        pos_orders / pos_print_jobs / pos_soldout 對 anon **只 grant SELECT**，
#        並收窄時間窗；**絕對不可以** grant insert / update / delete。
#        落單一律行 /api/pos/sync（server service_role）。
#
#     ⚠️ 加完之後**必須重新部署**（NEXT_PUBLIC_* 係 build-time inline）。
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_POS_SUPABASE_URL=https://your-pos-project.supabase.co
# NEXT_PUBLIC_POS_SUPABASE_ANON_KEY=your-pos-anon-key

# -----------------------------------------------------------------------------
# B-3. 🔐 簽名密鑰與安全開關（2026-09-15 補 — 之前完全冇喺本檔記錄過）
#
#      🔴 2026-10-21 更新（多店控制台 P0-1）：`ADMIN_SESSION_SECRET` 由「建議」改為
#         **生產必填**。已經**取消** fallback 到 `SUPABASE_SERVICE_ROLE_KEY`：
#           ① service key 一洩漏，攻擊者唔止讀寫 DB，仲可以直接**偽造 admin token**；
#           ② rotate service key 會令所有 admin token 靜默失效。
#         未設 = `/api/admin/session` 回 503（fail closed，唔會用其他 key 頂上）。
#
#      `POS_DEVICE_TOKEN_SECRET` 仍然係「冇設就退 `ADMIN_SESSION_SECRET` → service key」，
#      但**強烈建議兩支都設、而且唔同值** —— 否則 rotate admin secret 會連 POS 終端憑證
#      一齊失效（全部收銀機要重新登入）。
#
#      🔴 一旦設定／改動，**所有簽發中嘅 token 即刻失效** ⇒ 全部 POS 終端 / Admin 要重新登入。
#      ⇒ 建議首次上線前就設好；上線後才加，請揀非營業時間。
#
#      生成方式（64 個 hex 字元 = 256 bits，已遠超足夠）：
#        node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#      或 PowerShell：
#        [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32)).ToLower()
#      建議長度：**32 bytes（64 hex 字元）或以上**；最少唔好短過 32 字元。
#
#      ⚠️ 兩支 secret **必須唔同值**（一個用於 POS 終端憑證，一個用於 Admin session）。
#      ⚠️ 唔可以加 NEXT_PUBLIC_ 前綴（加咗會 inline 落瀏覽器 bundle = 公開）。
#      ⚠️ 唔好把真值寫入 repo／文件（2026-09-15 嘅 review 文件曾經出現過真值範例，
#         已視為洩漏 —— 果支 secret 唔可以再用）。
# -----------------------------------------------------------------------------
# POS_DEVICE_TOKEN_SECRET=<64 hex chars>
# ADMIN_SESSION_SECRET=<另一組 64 hex chars>   # 🔴 生產必填

# -----------------------------------------------------------------------------
# B-4. 🚨 應急回滾開關：完全關閉 POS 端點鑑權
#
#      預設（唔設 / 設 1 / true）= **開啟鑑權（fail-closed）**。
#      設 `0` / `false` / `off` = 關閉 ⇒ 所有 POS 端點唔再要求終端憑證。
#      （判定邏輯：src/lib/pos/pos-device-token.ts:136-140）
#
#      用途：萬一加咗鑑權後生產出事（例如憑證簽發環節壞、客戶端未更新），
#            改呢個環境變數即可即時回復，**唔需要重新部署**。
#      代價：關閉期間等於任何人知 storeId 就可以讀寫該店資料 ⇒ **只作臨時措施**，
#            處理完要即刻刪走呢行（或設返 1）。
# -----------------------------------------------------------------------------
# POS_REQUIRE_DEVICE_AUTH=0

# -----------------------------------------------------------------------------
# B-5. 【未啟用 · 根治跨店 Realtime 用】Supabase JWT Secret
#
#      用途：簽發帶 `store_id` claim 嘅短命 token，令 anon 讀取政策可以做到按店隔離。
#      未有呢支 secret 之前，pos_orders / pos_print_jobs 嘅 anon 政策**冇辦法**加
#      store_id 過濾（anon 冇 store claim）—— 詳見
#      supabase/migrations/0041_pos_anon_read_window_narrow.sql §3。
#
#      取法：Supabase Dashboard → POS 專案 → Project Settings → API → JWT Settings → JWT Secret
#      ⚠️ server-only，**絕對唔可以**加 NEXT_PUBLIC_ 前綴。
#      未落實 §3 之前唔需要設。
# -----------------------------------------------------------------------------
# SUPABASE_JWT_SECRET=

# -----------------------------------------------------------------------------
# E. 庫存模組（直連 expenseRecorder）＋ 手機版庫存表 QR SSO（2026-10-22）
#
#   E-1. expenseRecorder Supabase（service_role，server-only）
#       庫存模組直連讀寫 receipts / shop_users 用；未設 → 庫存功能降級
#       （顯示「未連線」）。詳見 docs/integration/。
#       🔴 絕對唔可以加 NEXT_PUBLIC_ 前綴、唔可以落前端、唔可以 commit 真值。
# EXPENSE_SUPABASE_URL=https://fjvfvpedklhdenavbcjg.supabase.co
# EXPENSE_SUPABASE_SERVICE_ROLE_KEY=
#
#   E-2. 手機版庫存表 QR（docs/integration/mobile-inventory-qr-2026-10-22.md）
#       庫存頁右上角「手機版庫存表」掣 → 彈窗 QR → 手機一掃即自動登入
#       expense-recorder-sigma.vercel.app 並直接使用。
#
#       🔴 MACAU_LEDGER_SSO_SECRET 係**兩邊必須一致**嘅共享密鑰：POS 用它簽
#       JWT，expenseRecorder 用它驗（對方 production 已啟用 SSO 並已設定）。
#       未設 → 彈窗顯示「尚未啟用（伺服器未設定 MACAU_LEDGER_SSO_SECRET）」。
#       取法：expenseRecorder Vercel Project → Settings → Environment Variables
#             → 複製 MACAU_LEDGER_SSO_SECRET 同一值過嚟 POS Vercel。
# MACAU_LEDGER_SSO_SECRET=
# MACAU_LEDGER_SSO_ISSUER=macau-ledger
# MACAU_LEDGER_SSO_AUDIENCE=expense-recorder
#
#   E-3. 可選：QR 指向嘅 expenseRecorder 網址（預設 production）
# EXPENSE_RECORDER_WEB_URL=https://expense-recorder-sigma.vercel.app
#
#   E-4. 可選：QR 有效期（秒，預設 300；clamp 60..900）
# POS_MOBILE_QR_TTL_SECONDS=300
