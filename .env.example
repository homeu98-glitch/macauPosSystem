# Ledger integration (macauPosSystem ↔ 澳門會員通)
#
# Copy to `.env.local` for local dev / set in Vercel project settings for deploy.
# Do NOT commit `.env.local`.

# Ledger Supabase — safe for frontend bundle
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — NEVER use NEXT_PUBLIC_ prefix
# Obtain from Ledger ops; required for /api/ledger/login
AUTH_PIN_PEPPER=
