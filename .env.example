# =============================================================================
# Macau POS — Environment Variables
# Copy to `.env.local` (local) or set in Vercel Project Settings (deploy).
# Do NOT commit `.env.local`.
# =============================================================================

# -----------------------------------------------------------------------------
# A. Ledger Supabase（必填 — 登入 + 線上訂單 + Realtime）
#    與 Macau-Ledger 共用同一個 Supabase 專案
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-ledger-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-ledger-anon-key

# Server-only — 與 Ledger Vercel 部署相同的 pepper；勿加 NEXT_PUBLIC_ 前綴
AUTH_PIN_PEPPER=

# -----------------------------------------------------------------------------
# A-2. Ledger 本體 base URL（確保會員建檔 ensure-customer 薄轉發用）
#     POS 伺服器路由 /api/ledger/ensure-customer 會帶店員 Bearer token 轉發到
#     `{LEDGER_INTEGRATION_BASE_URL}/api/integration/pos/ensure-customer`。
#     ⚠️ 入面預設值係 UAT（https://membership-uat.macau-tech.com）。
#        正式環境**必須**設去 production：
#        LEDGER_INTEGRATION_BASE_URL=https://membership.macau-tech.com
#     - 正式部署：喺 Vercel Project Settings → Environment Variables 設
#       （Production scope），唔使寫入任何檔案。
#     - 本地對 production 測試：寫入 `.env.local`（gitignore，唔會 commit）。
#     - 此變數只喺 server 端 Route Handler 讀，唔使加 NEXT_PUBLIC_ 前綴。
# -----------------------------------------------------------------------------
# LEDGER_INTEGRATION_BASE_URL=https://membership.macau-tech.com

# -----------------------------------------------------------------------------
# A-3. Ledger → POS 入站 webhook 簽名 secret（線上訂單「自動接單」雙向同步用，docs/92）
#      POS 伺服器路由 /api/integration/ledger/auto-accept 會用呢支 secret 驗 HMAC-SHA256 簽名：
#        signing_string = X-Pos-Timestamp + "." + raw_body
#        X-Pos-Signature: sha256=<hex>
#      ⚠️ **必須**同 Ledger 嗰邊夾定同一支值；server-only，**絕不加 NEXT_PUBLIC_ 前綴**。
#      未設定 → 入站 webhook 一律 500（唔會放行無簽名請求）。
# -----------------------------------------------------------------------------
# LEDGER_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# D. 會員線上充值審核（topUpAutomation iframe SSO）
#    TOPUP_SITEA_SSO_SECRET 須與 Ledger / topUpAutomation 的 SITEA_SSO_SECRET 相同
# -----------------------------------------------------------------------------
# TOPUP_SITEA_SSO_SECRET=
# TOPUP_SITEA_SSO_ISSUER=site-a
# TOPUP_SITEA_SSO_AUDIENCE=site-b
# NEXT_PUBLIC_TOPUP_BASE_URL=https://top-up-automation.vercel.app
# 店員登入號 ≠ 充值店舖編號時，以 merchant UUID 對應 8 位編號（例：表嫂美食 60000000）
# TOPUP_SHOP_ID_OVERRIDES={"11111111-1111-1111-1111-111111111111":"60000000"}

# -----------------------------------------------------------------------------
# C. 打印橋接（Android POS App 或 print-bridge）
#    瀏覽器 POS 透過此 URL 送打印任務；亦可在 設置→打印機 填寫本機橋接 URL 覆蓋
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_PRINT_BRIDGE_URL=http://192.168.1.50:9222

# -----------------------------------------------------------------------------
# B. POS 自有 Supabase（可選 — 店內雲同步 / Admin / Backoffice）
#    與 Ledger 分開的獨立專案；只用 SUPABASE_*，不要加 NEXT_PUBLIC_
#    若不配置：店內收銀仍可用 localStorage；Admin 用 mock
# -----------------------------------------------------------------------------
# SUPABASE_URL=https://your-pos-project.supabase.co
# SUPABASE_ANON_KEY=your-pos-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-pos-service-role-key
